# 统一 LF，避免 shell 脚本在 Windows 检出后变成 CRLF 导致
# `/usr/bin/env bash^M: bad interpreter`
* text=auto eol=lf

*.sh        text eol=lf
*.rs        text eol=lf
*.bp        text eol=lf
*.aidl      text eol=lf
*.rc        text eol=lf
*.conf      text eol=lf
*.xml       text eol=lf
*.toml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf

# 二进制
*.so        binary
